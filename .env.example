# ==============================================================================
# SmartBIU - LLM API Key Configuration
# Copy this file to .env:  cp .env.example .env
# Then fill in the API key for your chosen provider below:
# ==============================================================================

# Option 1: Groq (Recommended - Extremely fast & generous free tier: https://console.groq.com)
GROQ_API_KEY=

# Option 2: Google Gemini (Free tier available: https://aistudio.google.com)
GEMINI_API_KEY=

# Option 3: OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Option 4: Local Ollama (No API key needed, just ensure Ollama is running)
# OLLAMA_HOST=http://localhost:11434
